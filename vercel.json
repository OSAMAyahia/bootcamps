{
  "redirects": [
    {
      "source": "/",
      "destination": "/bootcamps/cybersecurity",
      "permanent": false
    },
    {
      "source": "/((?!next-assets/|custom/|opt/|cdn/|cdn-cgi/|brand/|logos/|img/|icons/|media/|api/|bootcamps/cybersecurity$|index\\.html$|empty\\.json$).*)",
      "destination": "/bootcamps/cybersecurity",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/bootcamps/cybersecurity",
      "destination": "/index.html"
    },
    {
      "source": "/next-assets/image",
      "has": [
        {
          "type": "query",
          "key": "url",
          "value": "/(?<p>.*)"
        }
      ],
      "destination": "/:p"
    },
    {
      "source": "/media/:path*",
      "destination": "/cdn/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/empty.json"
    }
  ]
}
